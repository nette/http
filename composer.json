{
	"name": "nette/http",
	"description": "🌐 Nette HTTP: the request, response, URL, cookies, sessions and file uploads as objects, with sanitized input and same-origin protection against CSRF.",
	"keywords": ["nette", "http", "request", "response", "url", "session", "cookies", "file upload", "csrf"],
	"homepage": "https://doc.nette.org/http",
	"license": ["BSD-3-Clause", "GPL-2.0-only", "GPL-3.0-only"],
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": "8.3 - 8.6",
		"nette/utils": "^4.1"
	},
	"require-dev": {
		"nette/di": "^3.2",
		"nette/tester": "^2.6",
		"nette/security": "^3.2",
		"tracy/tracy": "^2.12",
		"phpstan/phpstan": "^2.2@stable",
		"phpstan/extension-installer": "^1.4@stable",
		"nette/phpstan-rules": "^1.0"
	},
	"conflict": {
		"nette/di": "<3.0.3",
		"nette/schema": "<1.2"
	},
	"suggest": {
		"ext-fileinfo": "to detect MIME type of uploaded files by Nette\\Http\\FileUpload",
		"ext-gd": "to use image function in Nette\\Http\\FileUpload",
		"ext-session": "to use Nette\\Http\\Session",
		"ext-intl": "to support punycode by Nette\\Http\\Url"
	},
	"autoload": {
		"classmap": ["src/"],
		"psr-4": {
			"Nette\\": "src"
		}
	},
	"minimum-stability": "dev",
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "4.0-dev"
		}
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	}
}
